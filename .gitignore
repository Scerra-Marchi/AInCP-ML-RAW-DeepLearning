# project-wide ignores
__pycache__/
*.log
.vscode/

# ignore selected heavy artifacts inside each Iteration_* folder
**/Iteration_*/**/*.joblib
**/Iteration_*/**/pred_cache/
**/Iteration_*/**/*.png
**/Iteration_*/**/*.pdf

# ignore the virtual environment
**/venv/

# ignore debug iterations outputs (including summary files)
Pipeline/Iterations_debug/

# ignore generated timestamp cache files (e.g., timestamps_list_decim_3.joblib)
**/timestamps_list_decim_*.joblib

# ignore compressed archives
*.tar.gz

# ignore Dataset
Dataset
